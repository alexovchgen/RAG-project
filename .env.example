APP_NAME=RAG servise
LOG_LEVEL=INFO
DEBUG=false

LLM_API_KEY=<ключ вашего провайдера>
LLM_BASE_URL=https://api.vsellm.ru/v1
LLM_MODEL=qwen/qwen3.7-flash
LLM_TEMPERATURE=0.0

# Скрипты с ПК: localhost. В docker compose у app перебивается на http://qdrant:6333
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=sklearn_docs
TOP_K=4

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
NORMALIZE_EMBEDDINGS=true
